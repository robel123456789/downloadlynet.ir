{
 "manifest_version": 3,
 "name": "udemy player",
 "version": "8.0",
 "minimum_chrome_version": "109",
 "description": "udemy player: offline course library (with player, RAR extraction and subtitle merging) and the Curriculum builder.",
 "permissions": [
  "storage",
  "unlimitedStorage",
  "nativeMessaging"
 ],
 "action": {
  "default_popup": "popup.html",
  "default_title": "udemy player",
  "default_icon": {
   "16": "i16.png",
   "48": "i48.png",
   "128": "i128.png"
  }
 },
 "icons": {
  "16": "i16.png",
  "48": "i48.png",
  "128": "i128.png"
 },
 "key": ""
}